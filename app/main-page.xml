<Page xmlns="http://schemas.nativescript.org/tns.xsd"
      actionBarHidden="true"
      backgroundColor="#F4ECDF"
      navigatingTo="navigatingTo"
      loaded="onLoaded">

  <GridLayout rows="*, auto">

    <!-- ============================ map bay ============================ -->
    <GridLayout id="mapBand" row="0">

      <!-- real streets: MapLibre page loaded from map-src.ts by TS; bubbles +
           dashed ring + blue dot live inside the WebView, overlays stay native -->
      <WebView id="mapWeb" />

      <!-- top action stickers -->
      <GridLayout rows="auto" columns="*, auto, auto" marginLeft="16" marginRight="16"
                  marginTop="13" verticalAlignment="top" zIndex="5">
        <GridLayout id="locSticker" col="0" rows="auto" columns="auto"
                    horizontalAlignment="stretch"
                    tap="onStickerTap" touch="onStickerTouch">
          <StackLayout id="locStickerShadow" row="0" class="ho-topbar-shadow" />
          <GridLayout id="locStickerCard" row="0" class="ho-topbar" rows="auto"
                      columns="auto, auto, auto"
                      padding="9 13 9 11">
            <Image col="0" src="res://ic_locate_red" width="19" height="19"
                   verticalAlignment="center" stretch="aspectFit" />
            <StackLayout col="1" marginLeft="9">
              <Label text="YOUR LOCATION" class="ho-cap" marginTop="1" />
              <Label id="locLine" text="Gariahat · 2 km" class="ho-topbar-line" />
            </StackLayout>
            <Image col="2" src="res://ic_chev_dn" width="13" height="13" marginLeft="9"
                   verticalAlignment="center" stretch="aspectFit" />
          </GridLayout>
        </GridLayout>

        <GridLayout id="btnSearch" col="1" marginLeft="9" width="42" height="42"
                    tap="onSearchTap" touch="onStickerTouch">
          <StackLayout id="btnSearchShadow" class="ho-topbar-shadow" />
          <GridLayout id="btnSearchCard" class="ho-topbar">
            <Image src="res://ic_search_ink" width="19" height="19"
                   horizontalAlignment="center" verticalAlignment="center"
                   stretch="aspectFit" />
          </GridLayout>
        </GridLayout>

        <GridLayout id="btnBell" col="2" width="42" height="42" marginLeft="9"
                    tap="onBellTap" touch="onStickerTouch">
          <StackLayout id="btnBellShadow" class="ho-topbar-shadow" />
          <GridLayout id="btnBellCard" class="ho-topbar">
            <Image src="res://ic_bell_ink" width="18" height="18"
                   horizontalAlignment="center" verticalAlignment="center"
                   stretch="aspectFit" />
          </GridLayout>
          <Label id="bellBadge" text="3" class="ho-badge" width="20" height="20"
                 horizontalAlignment="right" verticalAlignment="top" />
        </GridLayout>
      </GridLayout>

      <!-- category chips float over the map top edge (mock row) -->
      <ScrollView orientation="horizontal" verticalAlignment="top" zIndex="6"
                  class="ho-chiprow" scrollBarIndicatorVisible="false"
                  marginTop="68">
        <StackLayout orientation="horizontal" paddingLeft="16">
          <GridLayout id="chip0" tap="onChipTap" touch="onStickerTouch"
                      marginRight="8">
            <StackLayout id="chipSh0" class="ho-chipshadow" />
            <GridLayout id="chipC0" class="ho-chipc-on">
              <Label id="chipT0" text="All" class="ho-chipT-on" />
            </GridLayout>
          </GridLayout>
          <GridLayout id="chip1" tap="onChipTap" touch="onStickerTouch"
                      marginRight="8">
            <StackLayout id="chipSh1" class="ho-chipshadow" />
            <GridLayout id="chipC1" class="ho-chipc">
              <Label id="chipT1" text="Food" class="ho-chipT" />
            </GridLayout>
          </GridLayout>
          <GridLayout id="chip2" tap="onChipTap" touch="onStickerTouch"
                      marginRight="8">
            <StackLayout id="chipSh2" class="ho-chipshadow" />
            <GridLayout id="chipC2" class="ho-chipc">
              <Label id="chipT2" text="Mishti" class="ho-chipT" />
            </GridLayout>
          </GridLayout>
          <GridLayout id="chip3" tap="onChipTap" touch="onStickerTouch"
                      marginRight="8">
            <StackLayout id="chipSh3" class="ho-chipshadow" />
            <GridLayout id="chipC3" class="ho-chipc">
              <Label id="chipT3" text="Fashion" class="ho-chipT" />
            </GridLayout>
          </GridLayout>
          <GridLayout id="chip4" tap="onChipTap" touch="onStickerTouch"
                      marginRight="8">
            <StackLayout id="chipSh4" class="ho-chipshadow" />
            <GridLayout id="chipC4" class="ho-chipc">
              <Label id="chipT4" text="Groceries" class="ho-chipT" />
            </GridLayout>
          </GridLayout>
          <GridLayout id="chip5" tap="onChipTap" touch="onStickerTouch"
                      marginRight="8">
            <StackLayout id="chipSh5" class="ho-chipshadow" />
            <GridLayout id="chipC5" class="ho-chipc">
              <Label id="chipT5" text="Electronics" class="ho-chipT" />
            </GridLayout>
          </GridLayout>
        </StackLayout>
      </ScrollView>

      <!-- round map controls (right edge of the map, pinned by TS) -->
      <GridLayout id="btnLocate" width="46" height="46" marginRight="18"
                  horizontalAlignment="right"
                  verticalAlignment="top" zIndex="5"
                  tap="onLocateTap" touch="onStickerTouch">
        <GridLayout id="btnLocateCard" class="ho-round">
          <Image src="res://ic_locate_red" width="21" height="21"
                 horizontalAlignment="center" verticalAlignment="center"
                 stretch="aspectFit" />
        </GridLayout>
      </GridLayout>
      <GridLayout id="btnLayers" width="40" height="40" marginRight="20"
                  horizontalAlignment="right"
                  verticalAlignment="top" zIndex="5"
                  tap="onLayersTap" touch="onStickerTouch">
        <GridLayout id="btnLayersCard" class="ho-round-sm">
          <Image src="res://ic_map_ink" width="18" height="18"
                 horizontalAlignment="center" verticalAlignment="center"
                 stretch="aspectFit" />
        </GridLayout>
      </GridLayout>

      <!-- offers sheet -->
      <GridLayout id="sheet" rows="auto, auto, *" class="ho-sheet"
                  verticalAlignment="bottom" horizontalAlignment="stretch"
                  zIndex="10">
        <StackLayout class="ho-handle" horizontalAlignment="center" marginTop="10" />

        <GridLayout row="1" columns="*, auto" marginLeft="22" marginTop="10"
                    marginRight="16">
          <StackLayout col="0">
            <Label id="offerCount" text="8 offers nearby" class="ho-h1" />
            <Label id="offerMeta" text="Within 2 km · updated just now" class="ho-sub"
                   marginTop="2" />
          </StackLayout>
          <GridLayout id="btnAll" col="1" verticalAlignment="top"
                      tap="onAllTap" touch="onStickerTouch">
            <StackLayout id="btnAllShadow" class="ho-topbar-shadow" />
            <GridLayout id="btnAllCard" class="ho-allpill" columns="auto, auto">
              <Image col="0" src="res://ic_list_ink" width="15" height="15"
                     verticalAlignment="center" stretch="aspectFit" />
              <Label col="1" text="All" class="ho-textAll" marginLeft="7" />
            </GridLayout>
          </GridLayout>
        </GridLayout>

        <ScrollView row="2" id="cardScroll" marginTop="13">
          <StackLayout id="cardStack" />
        </ScrollView>
      </GridLayout>
    </GridLayout>

    <!-- =========================== bottom nav =========================== -->
    <GridLayout row="1" columns="*, *, *, *" backgroundColor="#FFFFFF" height="76"
                id="navBar">
      <StackLayout col="0" id="tab0" tap="onTabTap" touch="onLinkTouch"
                   horizontalAlignment="center" verticalAlignment="center">
        <GridLayout id="tabPill0" width="68" height="36" class="ho-tabpill"
                    horizontalAlignment="center" verticalAlignment="top">
          <Image id="tabIco0" src="res://ic_pin_ink" width="22" height="22"
                 horizontalAlignment="center" verticalAlignment="center"
                 stretch="aspectFit" />
        </GridLayout>
        <Label id="tabLbl0" text="Nearby" class="ho-tab-on" marginTop="3"
               horizontalAlignment="center" />
      </StackLayout>

      <StackLayout col="1" id="tab1" tap="onTabTap" touch="onLinkTouch"
                   horizontalAlignment="center" verticalAlignment="center">
        <GridLayout id="tabPill1" width="46" height="27"
                    horizontalAlignment="center" verticalAlignment="top">
          <Image id="tabIco1" src="res://ic_grid_gy" width="20" height="20"
                 horizontalAlignment="center" verticalAlignment="center"
                 stretch="aspectFit" />
        </GridLayout>
        <Label id="tabLbl1" text="Explore" class="ho-tab-off" marginTop="3"
               horizontalAlignment="center" />
      </StackLayout>

      <StackLayout col="2" id="tab2" tap="onTabTap" touch="onLinkTouch"
                   horizontalAlignment="center" verticalAlignment="center">
        <GridLayout id="tabPill2" width="46" height="27"
                    horizontalAlignment="center" verticalAlignment="top">
          <Image id="tabIco2" src="res://ic_bkm_gy" width="20" height="20"
                 horizontalAlignment="center" verticalAlignment="center"
                 stretch="aspectFit" />
        </GridLayout>
        <Label id="tabLbl2" text="Saved" class="ho-tab-off" marginTop="3"
               horizontalAlignment="center" />
      </StackLayout>

      <StackLayout col="3" id="tab3" tap="onTabTap" touch="onLinkTouch"
                   horizontalAlignment="center" verticalAlignment="center">
        <GridLayout id="tabPill3" width="46" height="27"
                    horizontalAlignment="center" verticalAlignment="top">
          <Image id="tabIco3" src="res://ic_you_gy" width="20" height="20"
                 horizontalAlignment="center" verticalAlignment="center"
                 stretch="aspectFit" />
        </GridLayout>
        <Label id="tabLbl3" text="You" class="ho-tab-off" marginTop="3"
               horizontalAlignment="center" />
      </StackLayout>
    </GridLayout>
  </GridLayout>
</Page>
