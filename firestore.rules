rules_version = '2';

/* NearZoop Firestore security rules.
   users/{uid} — per-account state, owned by that user only.
   shops       — public read (offer bubbles render for guests too); signed-in
                 users may seed demo shops while there is no admin backoffice.
                 Tighten these seeds to a server task before public launch.
   everything else — closed. */

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /shops/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
